# Copy this file to .env and fill it in. .env stays on your machine: it is ignored by git,
# and Claude is blocked from reading it.

# The environment the tests run against: the name of a file in config/environments/.
TEST_ENV=local

# One account per role of the environment: <ENV>_<ROLE>_EMAIL and <ENV>_<ROLE>_PASSWORD.
# The demo application's only account, safe to share:
LOCAL_USER_EMAIL=demo@example.test
LOCAL_USER_PASSWORD=demo-password
